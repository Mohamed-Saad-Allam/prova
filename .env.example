# ===================================================
# Prova Platform - Environment Variables Template
# Copy this file to .env and fill in your credentials
# ===================================================

# ── Supabase Configuration (Frontend & Backend) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Serverless Function Secrets (Vercel / Node)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ── Google Gemini AI (Gemini Live & Standard Generative Models) ──
# Required for CV generation, questions synthesis, report grading, and Live Audio
GEMINI_API_KEY=your_google_gemini_api_key
VITE_GEMINI_API_KEY=your_google_gemini_api_key

# ── Cartesia Sonic API (Ultra-low latency <150ms Real-time Voice for Interviews) ──
# Get your API key from https://play.cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key_here
VITE_CARTESIA_API_KEY=your_cartesia_api_key_here

# ── Optional Deployment / Admin Configuration ──
PORT=5173
NODE_ENV=production
